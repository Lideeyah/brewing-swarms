# Brewing Frontend — Environment Variables
# Copy to .env.local for local development

# Backend API URL
# Local:      http://localhost:8000
# Production: https://brewing-swarms-api.onrender.com
VITE_ARC_API_URL=http://localhost:8000

# Google OAuth client ID (for Drive + Gmail integrations — optional)
VITE_GOOGLE_CLIENT_ID=

# Slack OAuth client ID (for Slack integration — optional)
VITE_SLACK_CLIENT_ID=
